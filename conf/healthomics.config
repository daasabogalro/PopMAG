/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for AWS HealthOmics
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Activated with the `healthomics` profile:

        aws omics start-run ... --engine-settings '{"profile":"healthomics"}'

    Deliberately contains no account IDs and no ECR URIs. HealthOmics can only pull from
    a private ECR registry in the same account and region, but the rewriting is done by
    the service at CreateWorkflow time via --container-registry-map, not here, so
    this file stays portable.

    Three things about HealthOmics drive everything below:

      1. publishDir must resolve under /mnt/workflow/pubdir. Other publish roots are
         rejected, and the run's real destination is StartRun --output-uri.
      2. Workflow tasks have no general internet access, so every database has to be
         supplied from S3. --checkm2_db, --metacerberus_db and --singlem_metapackage are
         effectively mandatory here; without them the pipeline tries to download them
         inside a task and the task fails.
      3. Nextflow does not manage a container engine, so `container` must resolve to a
         single static string. The ternaries in the modules are pinned below.
----------------------------------------------------------------------------------------
*/

params {
    // Required by HealthOmics; the run's S3 destination is set by --output-uri.
    outdir     = '/mnt/workflow/pubdir'

    // LAUNCH_SHINY_APP starts an interactive Shiny server and blocks on it until
    // shiny_timeout expires. There is no way to reach port 3838 on a HealthOmics task,
    // so it would only burn compute. Run the dashboard locally against the S3 output.
    skip_shiny = true
}

// No container engine is driven by Nextflow here, and a conda solve would need network
// access that the task does not have.
conda.enabled        = false
docker.enabled       = false
podman.enabled       = false
singularity.enabled  = false
apptainer.enabled    = false
shifter.enabled      = false
charliecloud.enabled = false

// The execution report, timeline and trace do not survive a HealthOmics run. They were
// enabled for a run that completed with no failures, and no pipeline_info/ appeared
// anywhere in the exported output. Nextflow writes all three from
// onFlowComplete, after the last task, and by then HealthOmics has taken over
// /mnt/workflow: the engine log's final line is its own
// "Removing broken symlinks in /mnt/workflow/workflowOuts", with no Nextflow completion
// banner after it.
//
// Leaving them on costs a failed write at the end of every run and gains nothing.
// HealthOmics records the same per-task CPU, memory and runtime figures itself, in the
// manifest/run/<id>/<uuid> CloudWatch stream, which is where to look for right-sizing
// numbers. (Independently, the trace's resource columns need `ps` (procps) in every task
// container, which most biocontainers lack.)
report.enabled   = false
timeline.enabled = false
trace.enabled    = false

// Pin the engine. HealthOmics resolves version *ranges* by its own preference order
// (23.10 > 22.04 > 24.10 > 25.10 > 26.04) rather than taking the highest match, so an
// exact version is the only unambiguous way to ask for one.
manifest.nextflowVersion = '24.10.8'

process {
    // conda.enabled = false is not always enough to stop a module's conda directive
    // being selected, so null it everywhere.
    withName: '.*' { conda = null }

    // HealthOmics retries service-side 5xx errors on its own; this covers task failures.
    errorStrategy = 'retry'
    maxRetries    = 1

    /*
     * Static container pins.
     *
     * Every module writes `container` as a ternary on workflow.containerEngine, which
     * has no meaningful value here, and most rely on `docker.registry = 'quay.io'` to
     * expand a bare `biocontainers/...` name -- something that only applies when a
     * container engine is enabled. Both are resolved below into single fully-qualified
     * upstream URIs.
     *
     * These exact strings are the keys a --container-registry-map must use, so any edit
     * here has to be mirrored there.
     */
    withName: '(.+:)?BOWTIE2_INSTRAIN_ALIGN' { container = 'quay.io/biocontainers/mulled-v2-ac74a7f02cebcfcc07d8e8d1d750af9c83b4d45a:577a697be67b5ae9b16f637fd723b8263a3898b3-0' }
    withName: '(.+:)?BOWTIE2_INSTRAIN_BUILD' { container = 'quay.io/biocontainers/bowtie2:2.4.2--py38h1c8e9b9_1' }
    withName: '(.+:)?CHECKM2_DATABASEDOWNLOAD' { container = 'quay.io/biocontainers/checkm2:1.1.0--pyh7e72e81_1' }
    withName: '(.+:)?CHECKM2_PREDICT' { container = 'community.wave.seqera.io/library/checkm2:1.1.0--60f287bc25d7a10d' }
    withName: '(.+:)?COVERM' { container = 'quay.io/biocontainers/coverm:0.7.0--hb4818e0_2' }
    withName: '(.+:)?DREP' { container = 'quay.io/biocontainers/drep:3.5.0--pyhdfd78af_0' }
    withName: '(.+:)?EXTRACT_BIN_METRICS' { container = 'docker.io/suyanan/python:pip-numpy-h5py-pandas-matplotlib-seaborn' }
    withName: '(.+:)?EXTRACT_CONTIG_NAMES' { container = 'community.wave.seqera.io/library/pip_biopython:326a6be8fb21b301' }
    withName: '(.+:)?FILTER_BINS' { container = 'quay.io/biocontainers/python:3.9--1' }
    withName: '(.+:)?GENERATE_HEATMAP' { container = 'docker.io/suyanan/python:pip-numpy-h5py-pandas-matplotlib-seaborn' }
    withName: '(.+:)?INSTRAIN_COMPARE' { container = 'quay.io/biocontainers/instrain:1.9.0--pyhdfd78af_0' }
    withName: '(.+:)?INSTRAIN_PROFILE' { container = 'quay.io/biocontainers/instrain:1.9.0--pyhdfd78af_0' }
    withName: '(.+:)?LAUNCH_SHINY_APP' { container = 'quay.io/daasabogalro/popmag-dashboard:latest' }
    withName: '(.+:)?MERGE_GENOME_REPORTS_INSTRAIN' { container = 'docker.io/suyanan/python:pip-numpy-h5py-pandas-matplotlib-seaborn' }
    withName: '(.+:)?MERGE_REPORTS_METACERBERUS_INSTRAIN' { container = 'docker.io/suyanan/python:pip-numpy-h5py-pandas-matplotlib-seaborn' }
    withName: '(.+:)?METACERBERUS_ANNOTATION' { container = 'quay.io/biocontainers/metacerberus:1.4.0--pyhdfd78af_1' }
    withName: '(.+:)?METACERBERUS_DATABASEDOWNLOAD' { container = 'quay.io/biocontainers/metacerberus:1.4.0--pyhdfd78af_1' }
    withName: '(.+:)?POGENOM' { container = 'docker.io/daasabogalro/pogenom:latest' }
    withName: '(.+:)?PRODIGAL' { container = 'quay.io/biocontainers/mulled-v2-2e442ba7b07bfa102b9cf8fac6221263cd746ab8:57f05cfa73f769d6ed6d54144cb3aa2a6a6b17e0-0' }
    withName: '(.+:)?SINGLEM' { container = 'quay.io/biocontainers/singlem:0.19.0--pyhdfd78af_0' }
    withName: '(.+:)?SINGLEM_METAPACKAGE' { container = 'quay.io/biocontainers/singlem:0.19.0--pyhdfd78af_0' }
    withName: '(.+:)?SNVS_TO_VCF' { container = 'docker.io/suyanan/python:pip-numpy-h5py-pandas-matplotlib-seaborn' }
    withName: '(.+:)?SUBSET_VCF_BY_GENOME' { container = 'docker.io/suyanan/python:pip-numpy-h5py-pandas-matplotlib-seaborn' }
    withName: '(.+:)?TRANSFORM_CHECKM2_REPORT' { container = 'quay.io/biocontainers/python:3.9--1' }
}
